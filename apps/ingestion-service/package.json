{
  "name": "@notebooklm-edge/ingestion-service",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "typecheck": "bun x tsc --noEmit",
    "lint": "bun x eslint . --max-warnings 0",
    "test:watch": "vitest",
    "test": "vitest run",
    "build": "bun run typecheck && tsc --build",
    "validate": "bun run lint && bun run typecheck && bun run test:run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "zod": "^4.6.7"
  }
}
